# Zkopíruj do .env a doplň skutečné hodnoty. .env se necommituje do gitu.
#
# Pravidlo: v kódu není žádná doména natvrdo. Všechny absolutní adresy
# (canonical, OG, odkazy v e-mailech, návratové URL platební brány) se skládají
# z APP_URL. Přechod na jinou doménu je tím jen změna tohoto souboru.

NODE_ENV=development
PORT=3000

# Základ všech absolutních adres, bez koncového lomítka.
#   vývoj:    http://127.0.0.1:3000
#   test:     https://test-lsd.francik.eu
#   produkce: https://lsd.francik.eu  (později https://www.lsd-trip.cz)
APP_URL=http://127.0.0.1:3000

# Jméno prostředí. Ukazuje se v administraci, aby bylo poznat, kde člověk je.
# vyvoj | test | produkce
#
# Zároveň rozhoduje o modulu „Ke schválení“ (akceptační testování): běží všude
# kromě produkce. Na produkci se jeho API vůbec nenamontuje.
PROSTREDI=vyvoj

# Kam se ukládají nahrané soubory (přílohy akceptace, ve fázi 5 fotogalerie).
# V Dockeru je to /app/uploads, což je volume - výchozí hodnota sedí, měnit
# není potřeba.
# UPLOAD_DIR=uploads

# Připojení k databázi (v Dockeru je DB_HOST vždy "db" - jméno service z compose)
DB_HOST=db
DB_PORT=3306
DB_NAME=lsdtrip
DB_USER=lsdtrip
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# Indexace vyhledávači: povolit (produkce) | zakazat (test i vývoj).
# "zakazat" pošle Disallow v robots.txt i hlavičku X-Robots-Tag: noindex.
ROBOTS=zakazat

# -------------------------------------------------------------------- e-maily
#
# EMAIL_REZIM:
#   vypnuto  = e-mail se jen zapíše do logu a nikam neodejde (výchozí, bezpečné)
#   schranka = neodesílá se nic, ale celý e-mail (HTML, text, přílohy) se uloží
#              do administrace do sekce E-maily. Tohle běží na testu: odkazy
#              v e-mailu fungují, takže se dá projít i pozvánka nebo reset hesla,
#              a Resend na testu vůbec není potřeba.
#   test     = VŠICHNI příjemci se přepíšou na EMAIL_TEST_PRIJEMCE a e-mail
#              se opravdu odešle (když je potřeba ověřit i doručení)
#   live     = e-maily chodí skutečným adresátům (jen produkce!)
EMAIL_REZIM=vypnuto
EMAIL_TEST_PRIJEMCE=
EMAIL_ODESILATEL=LSD <rezervace@lsd.francik.eu>
RESEND_API_KEY=

# ------------------------------------------------- platební brána Mo.one (fáze 4)
# test:     https://api-test.znpay.tech
# produkce: https://api.znpay.tech
MOONE_BASE_URL=https://api-test.znpay.tech
MOONE_CLIENT_ID=
MOONE_CLIENT_SECRET=

# ------------------------------------------------------------------ přihlášení
# Jak dlouho platí přihlášení do administrace (dny).
SESSION_DNI=14

# -------------------------------------------- jen pro docker compose (ne aplikace)
# Oddělení prostředí na VPS.
#
# VOLUME_PREFIX dává volumes výslovná jména (lsd_main_db, lsd_main_uploads),
# nezávislá na názvu adresáře. Přejmenování složky tím nemůže způsobit, že by
# Docker založil prázdnou databázi a stará data osiřela. Bez téhle proměnné
# compose schválně odmítne nastartovat.
#
#   produkce: lsd_main / latest / lsdtrip-app
#   test:     lsd_test / test   / lsdtrip-test-app
VOLUME_PREFIX=lsd_main
IMAGE_TAG=latest
APP_CONTAINER=lsdtrip-app
COMPOSE_PROJECT_NAME=lsdtrip
